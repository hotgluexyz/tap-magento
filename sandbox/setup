#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")" && pwd)"
cd "$root"

for command in docker python3; do
  if ! command -v "$command" >/dev/null; then
    echo "$command is required" >&2
    exit 1
  fi
done

docker compose up -d --wait db opensearch magento
docker compose run --rm setup

python3 - <<'PY'
import json
from pathlib import Path
from urllib.error import URLError
from urllib.request import Request, urlopen

config = json.loads(Path("local-config.json").read_text())
config_path = Path.cwd().parent / ".secrets" / "sandbox" / "config.json"

url = config["store_url"]
login = Request(
    f"{url}/rest/V1/integration/admin/token",
    data=json.dumps({
        "username": config["username"],
        "password": config["password"],
    }).encode(),
    headers={"Content-Type": "application/json"},
)
try:
    with urlopen(login, timeout=60) as response:
        token = json.load(response)
    request = Request(
        f"{url}/rest/V1/store/storeConfigs",
        headers={"Authorization": f"Bearer {token}"},
    )
    with urlopen(request, timeout=60) as response:
        json.load(response)
except (URLError, TimeoutError, ValueError):
    raise SystemExit("Magento REST check failed. Check the sandbox services and local-config.json.") from None

config_path.parent.mkdir(parents=True, exist_ok=True)
config.pop("username")
config.pop("password")
config["access_token"] = token
config_path.write_text(json.dumps(config, indent=4) + "\n")
config_path.chmod(0o600)
print(f"Updated {config_path}")
PY

echo "Sandbox is ready."
echo "  Store:  http://localhost:8081"
echo "  Admin:  http://localhost:8081/admin"
echo "  Admin login: sandbox/local-config.json"
echo "  Tap config: .secrets/sandbox/config.json"
echo "Run the tap from the repository root:"
echo "  poetry run tap-magento --config .secrets/sandbox/config.json"
